{
  "name": "grupo-rh-dev/backend-experience",
  "description": "Backend de la aplicacion de RH Experience",
  "type": "project",
  "autoload": {
    "psr-4": {
      "MVC\\": "./",
      "Controllers\\": "./controllers",
      "Model\\": "./models",
      "Classes\\": "./classes",
      "App\\": "core/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:report": "phpunit --log-junit reports/junit.xml --testdox-html reports/testdox.html --testdox-text reports/testdox.txt"
  },
  "authors": [
    {
      "name": "Omar-Grupo-RH",
      "email": "omar.gruporh@gmail.com"
    }
  ],
  "require": {
    "phpmailer/phpmailer": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^6.11",
    "stripe/stripe-php": "^18.0",
    "dompdf/dompdf": "^3.1",
    "endroid/qr-code": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  }
}
